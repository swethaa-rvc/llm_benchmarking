# Copy to .env and fill in whichever providers models.json actually references.
# Nothing here has a default that works.

# ── Azure OpenAI (if a candidate or the judge uses provider: azure_openai) ───
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ── OpenAI direct (if a candidate or the judge uses provider: openai) ────────
OPENAI_API_KEY=

# ── Anthropic (if a candidate or the judge uses provider: anthropic) ─────────
ANTHROPIC_API_KEY=

# ── Gemini (if a candidate or the judge uses provider: gemini) ───────────────
GEMINI_API_KEY=

# ── Together AI (if a candidate or the judge uses provider: together) ───────
TOGETHER_API_KEY=
